<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CodeWeave.UI.MainWindow"
        Title="CodeWeave"
        Width="980"
        Height="640"
        Icon="/assets/icon-256.png">
        
  <Grid RowDefinitions="Auto,*,Auto" Margin="24">

    <StackPanel Spacing="6">
      <TextBlock Text="CodeWeave"
                 FontSize="30"
                 FontWeight="Bold"/>
      <TextBlock Text="Drag a project folder here to generate an interactive code map."
                 Opacity="0.75"/>
    </StackPanel>

    <Border x:Name="DropZone"
            Grid.Row="1"
            Margin="0,20,0,20"
            Padding="28"
            CornerRadius="20"
            BorderThickness="2"
            BorderBrush="#4C6FFF"
            Background="#10162B">

      <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
        <TextBlock x:Name="DropTitle"
                   Text="Drop folder here"
                   HorizontalAlignment="Center"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Margin="0,0,0,10"/>

        <TextBlock x:Name="FolderPathText"
                   Grid.Row="1"
                   Text="No folder selected"
                   TextWrapping="Wrap"
                   MaxWidth="760"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   Opacity="0.7"
                   Margin="0,0,0,18"/>

        <ProgressBar x:Name="ScanProgressBar"
                     Grid.Row="2"
                     Minimum="0"
                     Maximum="100"
                     Value="0"
                     Height="12"
                     ShowProgressText="False"
                     Margin="0,0,0,8"/>

        <TextBlock x:Name="ProgressText"
                   Grid.Row="3"
                   Text="Ready to scan."
                   HorizontalAlignment="Center"
                   Opacity="0.75"
                   Margin="0,0,0,18"/>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="10">
          <Button x:Name="BrowseButton"
                  Content="Browse"
                  Width="130"
                  Click="BrowseButton_OnClick"/>

          <Button x:Name="ScanButton"
                  Content="Scan"
                  Width="130"
                  IsEnabled="False"
                  Click="ScanButton_OnClick"/>

          <Button x:Name="OpenOutputButton"
                  Content="Open Output"
                  Width="130"
                  IsEnabled="False"
                  Click="OpenOutputButton_OnClick"/>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2"
            Padding="14"
            CornerRadius="14"
            Background="#0C1224">
      <TextBlock x:Name="StatusText"
                 Text="Ready."
                 TextWrapping="Wrap"/>
    </Border>
  </Grid>
</Window>